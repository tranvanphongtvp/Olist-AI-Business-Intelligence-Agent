      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Cấu hình Telegram",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 500]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const update = $input.first().json;\nconst callback = update.callback_query;\nconst message = callback?.message ?? update.message;\nconst sender = callback?.from ?? message?.from;\nif (!message?.chat?.id || !sender || sender.is_bot) return [];\n\nconst event = {\n  chat_id: String(message.chat.id),\n  message_id: message.message_id,\n  callback_id: callback?.id ?? '',\n  action: 'notice',\n  question: '',\n  decision: '',\n  run_id: '',\n  notice: '',\n};\n\nif (String(sender.id) !== String(update.allowed_user_id).trim()) {\n  event.notice = 'Bạn không có quyền hỏi hoặc duyệt báo cáo của bot này.';\n} else if (callback) {\n  const match = /^(approve|reject):([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i.exec(callback.data ?? '');\n  if (match) {\n    event.action = 'callback';\n    event.decision = match[1].toLowerCase();\n    event.run_id = match[2];\n  } else {\n    event.notice = 'Nút duyệt không hợp lệ. Hãy dùng nút trong tin nhắn báo cáo.';\n  }\n} else {\n  const text = typeof message.text === 'string' ? message.text.trim() : '';\n  if (!text || text.startsWith('/')) {\n    event.notice = 'Gửi câu hỏi bằng chữ, ví dụ: Doanh thu tháng 8/2018 so với tháng 7/2018 thay đổi thế nào? Mỗi tin nhắn là một câu hỏi độc lập.';\n  } else if (Array.from(text).length < 3 || Array.from(text).length > 500) {\n    event.notice = 'Câu hỏi cần từ 3 đến 500 ký tự. Hãy gửi lại câu hỏi ngắn gọn hơn.';\n  } else {\n    event.action = 'question';\n    event.question = text;\n  }\n}\n\nreturn [{ json: event, pairedItem: { item: 0 } }];"
      },
