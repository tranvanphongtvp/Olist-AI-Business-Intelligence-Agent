      "typeVersion": 1.1,
      "position": [0, 500],
      "webhookId": "b1000000-0000-4000-8000-000000000001",
      "credentials": {
        "telegramApi": { "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID", "name": "Telegram bot" }
      }
    },
    {
      "parameters": {
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "api_base",
              "value": "http://host.docker.internal:8000",
              "type": "string"
            },
            {
              "id": "e2",
