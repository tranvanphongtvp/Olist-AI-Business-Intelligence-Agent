    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const run = $input.first().json.body;\nconst text = ['CẦN DUYỆT BÁO CÁO', 'Run: ' + run.run_id, 'Câu hỏi: ' + run.question, '', run.findings ?? '', '', 'Số chưa khớp dữ liệu: ' + run.warnings.join(', '), '', 'Bấm Duyệt / Từ chối ở cuối phần phân tích.'].join('\\n');\nconst chars = Array.from(text);\nconst total = Math.ceil(chars.length / 3500);\nconst items = [];\nfor (let i = 0; i < total; i++) {\n  const part = chars.slice(i * 3500, (i + 1) * 3500).join('');\n  items.push({\n    json: {\n      text: ('Phần ' + (i + 1) + '/' + total + '\\n' + part).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'),\n      run_id: run.run_id,\n      is_last: i === total - 1,\n    },\n    pairedItem: { item: 0 },\n  });\n}\nreturn items;"
      },
