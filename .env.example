# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env lên git.

# Tài khoản quản trị (dùng để load dữ liệu và chạy migration)
POSTGRES_USER=olist_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=olist
POSTGRES_PORT=5432

# Tài khoản CHỈ ĐỌC cho SQL Agent (chỉ được đọc schema analytics)
AGENT_DB_USER=agent_ro
AGENT_DB_PASSWORD=change_me_agent

# OpenAI
OPENAI_API_KEY=

# Tên model OpenAI. Chọn model từ tài khoản OpenAI của bạn (danh sách model thay đổi theo thời gian).
OPENAI_MODEL=

# Chọn nhà cung cấp LLM: openai (mặc định) hoặc groq
LLM_PROVIDER=openai

# Groq (dùng khi LLM_PROVIDER=groq). Tên model lấy từ console.groq.com
GROQ_API_KEY=
GROQ_MODEL=

# API cho n8n gọi. Đặt một chuỗi ngẫu nhiên dài, n8n phải gửi đúng chuỗi này trong header X-API-Key
API_KEY=

# Tài khoản GHI lịch sử báo cáo và checkpoint (khác với agent_ro, chỉ đọc)
WRITER_DB_USER=reporter
WRITER_DB_PASSWORD=change_me_writer
